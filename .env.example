# ============================================================================
# Observability Stack — Variables de entorno
# ============================================================================

# IP del servidor (para GF_SERVER_ROOT_URL)
SERVER_IP=192.0.2.10

# Grafana admin credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=           # Requerido. Generar: openssl rand -hex 16
GRAFANA_SECRET_KEY=               # Requerido. Generar: openssl rand -hex 32

# SendGrid SMTP — para que Grafana envíe alertas por email (misma API key que mailsender)
SENDGRID_API_KEY=                 # Requerido. Copiar de mailsender/.env
